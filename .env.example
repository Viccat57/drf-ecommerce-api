# ─── Base de datos ───────────────────────────────────────────
# Estos valores deben coincidir con los del servicio `db` en docker-compose.yml
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

# ─── Django ──────────────────────────────────────────────────
# DJANGO_SECRET_KEY se genera automáticamente en /secrets/app/django_secret_key
# y el entrypoint lo carga desde ahí. NO lo definas aquí.
# DJANGO_DEBUG=1 activa el modo debug de Django (solo para desarrollo).
DJANGO_DEBUG=0

# ─── Superusuario ────────────────────────────────────────────
# La contraseña se genera automáticamente en /secrets/app/django_admin_password.
# Solo el usuario y email son configurables aquí.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ─── Datos de demostración ───────────────────────────────────
# true = crea marcas, categorías y productos al arrancar (y luego embeddings con --profile ai)
# false = no crea nada; puedes correr seed_demo manualmente después
SEED_DEMO=false

# ─── IA (Ollama) ─────────────────────────────────────────────
AI_BASE_URL=http://ollama:11434
AI_EMBED_MODEL=nomic-embed-text
AI_CHAT_MODEL=qwen3.5:4b

# ─── Garage (S3) ─────────────────────────────────────────────
# Las credenciales S3 (GARAGE_ACCESS_KEY_ID, GARAGE_SECRET_ACCESS_KEY)
# se generan automáticamente por init_garage.py y se guardan en
# /secrets/s3/garage_s3.env. NO las definas aquí.
GARAGE_BUCKET_NAME=ecommerce-images
GARAGE_ENDPOINT_URL=http://garage:3900
GARAGE_REGION=garage